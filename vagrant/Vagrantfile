# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Общие настройки для всех VM
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false
  
  # SSH настройки
  config.ssh.insert_key = false
  config.ssh.forward_agent = true
  
  # Провайдер VirtualBox
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
    vb.name = "SCADA-Server"
  end

  # SCADA Master (основной сервер)
  config.vm.define "scada-master" do |master|
    master.vm.hostname = "scada-master"
    master.vm.network "private_network", ip: "192.168.56.10"
    master.vm.network "forwarded_port", guest: 80, host: 8880
    master.vm.network "forwarded_port", guest: 443, host: 8443
    master.vm.network "forwarded_port", guest: 3000, host: 3000
    master.vm.network "forwarded_port", guest: 9090, host: 19090
    master.vm.network "forwarded_port", guest: 1880, host: 1180
    master.vm.network "forwarded_port", guest: 8086, host: 18086
    
    master.vm.provider "virtualbox" do |vb|
      vb.memory = "4096"
      vb.cpus = 2
      vb.name = "SCADA-Master"
    end
    
    master.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y python3 python3-pip docker.io docker-compose
      systemctl enable docker
      systemctl start docker
      usermod -aG docker vagrant
    SHELL
  end

  # SCADA Worker 1 (дополнительный сервер)
  config.vm.define "scada-worker-1" do |worker|
    worker.vm.hostname = "scada-worker-1"
    worker.vm.network "private_network", ip: "192.168.56.11"
    
    worker.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
      vb.name = "SCADA-Worker-1"
    end
    
    worker.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y python3 python3-pip docker.io
      systemctl enable docker
      systemctl start docker
      usermod -aG docker vagrant
    SHELL
  end

  # SCADA Worker 2 (дополнительный сервер)
  config.vm.define "scada-worker-2" do |worker|
    worker.vm.hostname = "scada-worker-2"
    worker.vm.network "private_network", ip: "192.168.56.12"
    
    worker.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
      vb.name = "SCADA-Worker-2"
    end
    
    worker.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y python3 python3-pip docker.io
      systemctl enable docker
      systemctl start docker
      usermod -aG docker vagrant
    SHELL
  end
end
