---
profile: moderate

skip_list:
  - yaml[line-length]
  - yaml[comments]
  - name[missing]
  - risky-shell-pipe
  - schema
  - no-changed-when
  - var-naming[no-role-prefix]
  - role-name[path]
  - fqcn[keyword]

exclude_paths:
  - .github/
  - .git/
  - roles/geerlingguy.docker/
  - .ansible/
  - molecule/
  - tests/
  - collections/

use_default_rules: true
verbosity: 1
