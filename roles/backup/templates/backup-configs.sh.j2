#!/bin/bash
# Backup configuration files
set -e

BACKUP_DIR="{{ backup_configs_dir }}"
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_PATH="${BACKUP_DIR}/configs_${DATE}"
SCADA_DIR="{{ scada_base_dir }}"

mkdir -p "${BACKUP_PATH}"

echo "[$(date)] Starting configs backup..."

# Backup all config files
for config in docker-compose.yml prometheus.yml alert-rules.yml alertmanager.yml mosquitto.conf passwordfile; do
  if [ -f "${SCADA_DIR}/${config}" ]; then
    cp "${SCADA_DIR}/${config}" "${BACKUP_PATH}/"
    echo "  - Backed up: $config"
  fi
done

# Compress backup
{% if backup_compression %}
cd "${BACKUP_DIR}"
tar -czf "configs_${DATE}.tar.gz" "configs_${DATE}"
rm -rf "configs_${DATE}"
echo "[$(date)] Backup compressed: configs_${DATE}.tar.gz"
{% endif %}

echo "[$(date)] Configs backup completed"
ls -lh "${BACKUP_DIR}" | tail -5
