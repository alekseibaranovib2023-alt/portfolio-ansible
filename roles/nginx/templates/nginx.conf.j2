worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript 
               application/x-javascript application/xml+rss application/json;

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Redirect HTTP to HTTPS
    server {
        listen 80;
        server_name {{ nginx_domain }};
        return 301 https://$server_name$request_uri;
    }

    # HTTPS server - главный вход (Grafana)
    server {
        listen 443 ssl;
        server_name {{ nginx_domain }};

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

{% if basic_auth_enabled %}
        auth_basic "SCADA Access";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;
{% endif %}

        # Grafana на корне
        location / {
            proxy_pass {{ grafana_backend }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    # Prometheus - отдельный server block
    server {
        listen 443 ssl;
        server_name prometheus.{{ nginx_domain }};

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

{% if basic_auth_enabled %}
        auth_basic "SCADA Access";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;
{% endif %}

        location / {
            proxy_pass {{ prometheus_backend }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Alertmanager
    server {
        listen 443 ssl;
        server_name alertmanager.{{ nginx_domain }};

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

{% if basic_auth_enabled %}
        auth_basic "SCADA Access";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;
{% endif %}

        location / {
            proxy_pass {{ alertmanager_backend }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Node-RED
    server {
        listen 443 ssl;
        server_name nodered.{{ nginx_domain }};

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

{% if basic_auth_enabled %}
        auth_basic "SCADA Access";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;
{% endif %}

        location / {
            proxy_pass {{ nodered_backend }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    # InfluxDB
    server {
        listen 443 ssl;
        server_name influxdb.{{ nginx_domain }};

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

{% if basic_auth_enabled %}
        auth_basic "SCADA Access";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;
{% endif %}

        location / {
            proxy_pass {{ influxdb_backend }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # cAdvisor
    server {
        listen 443 ssl;
        server_name cadvisor.{{ nginx_domain }};

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

{% if basic_auth_enabled %}
